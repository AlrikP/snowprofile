# Secrets for .env.local; `bun run env:init` creates the file and fills them in. Non-secret
# local defaults live in .env.development. src/env.ts validates the values at startup. Keep
# secrets unprefixed: VITE_ variables reach the browser bundle.

# At least 32 characters: bunx --bun @better-auth/cli secret
BETTER_AUTH_SECRET=

# Not secrets; .env.development sets these. Override them here if you need to.
# DATABASE_URL=file:local.db
