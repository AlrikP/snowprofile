{
	servers {
		# Cloudflare's ranges (https://www.cloudflare.com/ips/, from snowtime's Caddyfile,
		# 2026-09-30). Caddy takes the client IP from CF-Connecting-IP only when the request
		# comes from one of them; otherwise it's the connection's address.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# Caddy gets the certificate (from Let's Encrypt, or its own authority for localhost) and
# redirects HTTP to HTTPS by itself.
{$APP_HOST} {
	# The public files baked into this image, from the same build as the app image.
	root * /srv/snowprofile

	log {
		output stdout
		format json
	}

	encode zstd gzip {
		minimum_length 1024
	}

	header {
		# No preload: that is a commitment for the whole domain, made on its apex.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	# The build hashes the names in /assets/, so they never change.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	@file file {path}
	handle @file {
		file_server
	}

	handle {
		header Cache-Control "private, no-store"
		reverse_proxy app:3000 {
			# While the app restarts, requests wait for it instead of failing with 502.
			lb_try_duration 30s
			lb_try_interval 250ms
			# Set from Caddy's client IP, so a client that bypasses Cloudflare can't choose
			# its own address. The app reads it (CLIENT_IP_HEADER).
			header_up CF-Connecting-IP {client_ip}
		}
	}
}
