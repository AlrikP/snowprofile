# Copy to .env next to compose.yml. The app validates these at startup (src/env.ts).

# The host name Caddy serves and gets a certificate for. localhost uses Caddy's own
# certificate authority, so the browser warns once. Where ports 80 and 443 are taken
# locally, use APP_HOST=localhost:8443 with HTTP_PORT=8080 and HTTPS_PORT=8443.
APP_HOST=localhost
# HTTP_PORT=80
# HTTPS_PORT=443
# The image tag: a release the Compose deploy workflow published, or "local" to build
# from this checkout.
RELEASE=local
# The database volume. Demo and company stacks use different names, never the same one.
DATABASE_VOLUME=snowprofile_demo_data

# At least 32 characters: bunx --bun @better-auth/cli secret
BETTER_AUTH_SECRET=

# A demo stack signs in the seeded users. For the company stack, set DEMO_MODE=false, the
# Google client, and ALLOWED_LOGIN_DOMAINS; DEMO_MODE and ALLOWED_LOGIN_DOMAINS are never
# on together.
DEMO_MODE=true
ALLOWED_LOGIN_DOMAINS=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
