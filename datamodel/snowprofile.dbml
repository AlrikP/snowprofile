// Generated from src/db/schema.ts and datamodel/notes.ts by datamodel/generate-dbml.ts.
// Do not edit: run `bun run datamodel:generate`.

Project snowprofile {
  database_type: 'SQLite'
  Note: '''
    Data model for snowprofile on SQLite.

    Tables in the auth and tenancy groups belong to Better Auth and its organization
    plugin; their shape follows the plugin. Everything else is owned by the app.
  '''
}

// --- Auth (Better Auth core) -------------------------------------------------------------

Table user [note: 'Better Auth user. One row per human, shared across organizations. Never hard-deleted: erasure anonymizes the row, so audit references stay valid.'] {
  id text [pk, note: 'UUIDv7, generated by the app through the Better Auth generateId hook.']
  name text [not null, note: 'Display name from Google or the seed. The name on CVs is employee_profile.full_name.']
  email text [not null, unique, note: 'Sign-in email, stored lowercased.']
  email_verified integer [not null, default: 0, note: 'Boolean.']
  image text [note: 'Avatar URL.']
  created_at integer [not null, note: 'Epoch ms, UTC.']
  updated_at integer [not null, note: 'Epoch ms, UTC.']
  locale text [note: 'The UI language the user chose: et or en (CHECK). Null until chosen; the cookie or the browser decides until then.']
}

Table session [note: 'Better Auth session. Carries the active organization, where the app opens after sign-in. Server functions take the organization from their input, not from here.'] {
  id text [pk]
  user_id text [not null, ref: > user.id, note: 'ON DELETE CASCADE.']
  token text [not null, unique, note: 'Session token held in the cookie.']
  expires_at integer [not null, note: 'Epoch ms, UTC.']
  ip_address text
  user_agent text
  active_organization_id text [ref: > organization.id, note: 'Organization plugin. The tenant every query in this session is scoped to. ON DELETE SET NULL.']
  created_at integer [not null]
  updated_at integer [not null]

  indexes {
    user_id
  }
}

Table account [note: 'Better Auth credential or linked provider: Google, or a password for seeded demo users.'] {
  id text [pk]
  user_id text [not null, ref: > user.id, note: 'ON DELETE CASCADE.']
  account_id text [not null, note: 'Identifier at the provider; equals user_id for the credential provider.']
  provider_id text [not null, note: 'google or credential.']
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at integer
  refresh_token_expires_at integer
  scope text
  password text [note: 'Password hash, credential provider only. Exists only in seeded data.']
  created_at integer [not null]
  updated_at integer [not null]

  indexes {
    user_id
    (provider_id, account_id)
  }
}

Table verification [note: 'Better Auth one-time values, such as OAuth state.'] {
  id text [pk]
  identifier text [not null]
  value text [not null]
  expires_at integer [not null]
  created_at integer [not null]
  updated_at integer [not null]

  indexes {
    identifier
  }
}

// --- Tenancy (Better Auth organization plugin, no teams) ---------------------------------

Table organization [note: 'Tenant. Every app-owned table carries organization_id, and every query filters by it. Deletion through Better Auth is disabled.'] {
  id text [pk]
  name text [not null]
  slug text [not null, unique, note: 'URL-safe handle.']
  logo text
  metadata text [note: 'Plugin-defined JSON. Not used by the app.']
  created_at integer [not null]
}

Table member [note: 'Membership: a user in an organization, with a role. A user can belong to several organizations.'] {
  id text [pk]
  organization_id text [not null, ref: > organization.id, note: 'ON DELETE CASCADE.']
  user_id text [not null, ref: > user.id, note: 'ON DELETE CASCADE.']
  role text [not null, default: 'employee', note: 'admin or employee, configured as custom plugin roles. No CHECK: the plugin can store several roles comma-separated, and later roles need no migration.']
  created_at integer [not null]

  indexes {
    (organization_id, user_id) [unique]
    user_id
  }
}

Table invitation [note: 'Invitation to an organization, shared as a link (no email in the MVP).'] {
  id text [pk]
  organization_id text [not null, ref: > organization.id, note: 'ON DELETE CASCADE.']
  email text [not null, note: 'Invitee address, lowercased. Google sign-in with this address accepts it.']
  role text [note: 'Role granted on acceptance: admin or employee.']
  status text [not null, default: 'pending', note: 'pending, accepted, rejected, canceled.']
  expires_at integer [not null]
  inviter_id text [not null, ref: > user.id, note: 'ON DELETE CASCADE.']
  created_at integer [not null]

  indexes {
    (organization_id, email)
  }
}

// --- Catalogue ---------------------------------------------------------------------------
// Audit columns on every app-owned table: created_* always, updated_* where rows change,
// sys_deleted on entities users delete. Composite foreign keys keep references inside one
// organization; the diagram draws only the single-column part.

Table technology_category [note: 'A group in the technology catalogue, per organization. Seeded with Frontend, Backend, Data, Infra, Testing, and Other.'] {
  id text [pk, note: 'UUIDv7, generated by the app.']
  organization_id text [not null, ref: > organization.id]
  name_et text [note: 'Bilingual: at least one of name_et and name_en (CHECK).']
  name_en text
  position integer [not null, default: 0, note: 'Sort order in lists and CVs.']
  created_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Epoch ms, set by the database.']
  created_by text [not null, ref: > user.id, note: 'Audit. Acting user, set by the app per request.']
  updated_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Set by the app on update; trigger fallback.']
  updated_by text [not null, ref: > user.id, note: 'Audit. Acting user of the last change, set by the app.']
  sys_deleted integer [not null, default: 0, note: 'Audit. Logical delete, CHECK 0 or 1. Refused while live technologies use the category.']

  indexes {
    organization_id
    (id, organization_id) [unique, note: 'Target of composite foreign keys.']
  }
}

Table technology [note: 'A catalogue entry, such as PostgreSQL. Anyone adds entries; admins rename, recategorize, and merge duplicates.'] {
  id text [pk, note: 'UUIDv7, generated by the app.']
  organization_id text [not null, ref: > organization.id]
  category_id text [not null, ref: > technology_category.id, note: 'Composite FK (category_id, organization_id) to technology_category (id, organization_id).']
  name text [not null, note: 'Proper name, the same in both languages.']
  normalized_name text [not null, note: 'name lowercased with spaces and punctuation removed, set by the app. Catches Postgres SQL against PostgreSQL, and matches import values.']
  merged_into_id text [ref: > technology.id, note: 'Set when an admin merges this entry into another: links move to the survivor and this row is soft-deleted. The import maps the old name to the survivor. Composite FK (merged_into_id, organization_id) to technology (id, organization_id).']
  note text [note: 'Plain text an admin writes, up to 1,000 characters, in one language: what the entry covers, why it is not a duplicate of a look-alike, or documentation links. Every member reads it.']
  created_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Epoch ms, set by the database.']
  created_by text [not null, ref: > user.id, note: 'Audit. Acting user, set by the app per request.']
  updated_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Set by the app on update; trigger fallback.']
  updated_by text [not null, ref: > user.id, note: 'Audit. Acting user of the last change, set by the app.']
  sys_deleted integer [not null, default: 0, note: 'Audit. Logical delete, CHECK 0 or 1.']

  indexes {
    (organization_id, normalized_name) [unique, note: 'Partial: WHERE sys_deleted = 0. One live entry per name.']
    (id, organization_id) [unique, note: 'Target of composite foreign keys.']
    category_id
  }
}

Table technology_distinct_pair [note: 'Two technologies an admin marked "Not a duplicate", so the near-duplicate rule never suggests them again. Inserted once, never updated.'] {
  technology_id text [not null, ref: > technology.id, note: 'The lower of the two IDs, so a pair is stored once. Composite FK (technology_id, organization_id) to technology (id, organization_id).']
  other_technology_id text [not null, ref: > technology.id, note: 'The higher of the two IDs. Composite FK (other_technology_id, organization_id) to technology (id, organization_id).']
  organization_id text [not null, ref: > organization.id, note: 'Tenant key, equal to the organization of both technologies through the composite foreign keys.']
  created_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Epoch ms, set by the database.']
  created_by text [not null, ref: > user.id, note: 'Audit. Acting user, set by the app per request.']

  indexes {
    (technology_id, other_technology_id) [pk]
    organization_id
    other_technology_id
  }
}

Table tender_criterion [note: 'A yes or no question that tenders ask about projects, such as automated tests or X-Road. Admins manage the list.'] {
  id text [pk, note: 'UUIDv7, generated by the app.']
  organization_id text [not null, ref: > organization.id]
  name_et text [note: 'Bilingual: at least one of name_et and name_en (CHECK).']
  name_en text
  position integer [not null, default: 0, note: 'Sort order in the checklist.']
  created_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Epoch ms, set by the database.']
  created_by text [not null, ref: > user.id, note: 'Audit. Acting user, set by the app per request.']
  updated_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Set by the app on update; trigger fallback.']
  updated_by text [not null, ref: > user.id, note: 'Audit. Acting user of the last change, set by the app.']
  sys_deleted integer [not null, default: 0, note: 'Audit. Logical delete, CHECK 0 or 1. Answers stay but no longer show.']

  indexes {
    organization_id
    (id, organization_id) [unique, note: 'Target of composite foreign keys.']
  }
}

Table project_role [note: 'A role in the role catalogue, such as arendaja / developer. Anyone adds entries with both names; admins rename and merge duplicates. Entries from the sheet migration can lack the English name.'] {
  id text [pk, note: 'UUIDv7, generated by the app.']
  organization_id text [not null, ref: > organization.id]
  name_et text [note: 'Bilingual: at least one of name_et and name_en (CHECK).']
  name_en text
  normalized_name text [not null, note: 'name_et, or name_en when it is missing, lowercased without diacritics, spaces, or punctuation, set by the app. Catches arendaja against Arendaja.']
  merged_into_id text [ref: > project_role.id, note: 'Set when an admin merges this entry into another: links move to the survivor and this row is soft-deleted. Composite FK (merged_into_id, organization_id) to project_role (id, organization_id).']
  created_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Epoch ms, set by the database.']
  created_by text [not null, ref: > user.id, note: 'Audit. Acting user, set by the app per request.']
  updated_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Set by the app on update; trigger fallback.']
  updated_by text [not null, ref: > user.id, note: 'Audit. Acting user of the last change, set by the app.']
  sys_deleted integer [not null, default: 0, note: 'Audit. Logical delete, CHECK 0 or 1.']

  indexes {
    (organization_id, normalized_name) [unique, note: 'Partial: WHERE sys_deleted = 0. One live entry per name.']
    (id, organization_id) [unique, note: 'Target of composite foreign keys.']
  }
}

// --- Projects ----------------------------------------------------------------------------

Table customer [note: 'An ordering organization (tellija), such as a ministry or Telia.'] {
  id text [pk, note: 'UUIDv7, generated by the app.']
  organization_id text [not null, ref: > organization.id]
  name text [not null, note: 'Proper name, the same in both languages.']
  created_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Epoch ms, set by the database.']
  created_by text [not null, ref: > user.id, note: 'Audit. Acting user, set by the app per request.']
  updated_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Set by the app on update; trigger fallback.']
  updated_by text [not null, ref: > user.id, note: 'Audit. Acting user of the last change, set by the app.']
  sys_deleted integer [not null, default: 0, note: 'Audit. Logical delete, CHECK 0 or 1. Refused while live projects name the customer.']

  indexes {
    (organization_id, name) [unique, note: 'Partial: WHERE sys_deleted = 0.']
    (id, organization_id) [unique, note: 'Target of composite foreign keys.']
  }
}

Table contact_person [note: 'A person at a customer, given as a tender reference. Third-party personal data: only what references need.'] {
  id text [pk, note: 'UUIDv7, generated by the app.']
  organization_id text [not null, ref: > organization.id]
  customer_id text [not null, ref: > customer.id, note: 'Composite FK (customer_id, organization_id) to customer (id, organization_id).']
  name text [not null]
  email text
  phone text
  no_longer_valid integer [not null, default: 0, note: 'Boolean, CHECK 0 or 1. Set when the person can no longer act as a reference; CV tables leave them out.']
  note text [note: 'Free text, such as no longer works at Telia. Not shown in CVs.']
  created_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Epoch ms, set by the database.']
  created_by text [not null, ref: > user.id, note: 'Audit. Acting user, set by the app per request.']
  updated_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Set by the app on update; trigger fallback.']
  updated_by text [not null, ref: > user.id, note: 'Audit. Acting user of the last change, set by the app.']
  sys_deleted integer [not null, default: 0, note: 'Audit. Logical delete, CHECK 0 or 1.']

  indexes {
    organization_id
    customer_id
    (id, organization_id) [unique, note: 'Target of composite foreign keys.']
  }
}

Table project [note: 'An organization project. Admins create and edit it; every member sees it in the project list. Own projects are in own_project instead.'] {
  id text [pk, note: 'UUIDv7, generated by the app.']
  organization_id text [not null, ref: > organization.id]
  customer_id text [ref: > customer.id, note: 'Null when the customer is unknown, for example after an import. Composite FK (customer_id, organization_id) to customer (id, organization_id).']
  name text [not null, note: 'Proper name, the same in both languages.']
  normalized_name text [not null, note: 'name lowercased with spaces and punctuation removed, set by the app, as on technology. Not unique: two projects can share a name. The import matches name variants from employee sheets against it, and the app warns about a similar existing name.']
  description_et text
  description_en text
  start_date text [not null, note: 'Period start: YYYY-MM-DD, YYYY-MM, or YYYY, as precise as known (CHECK on the format). Shown as DD-MM-YYYY, MM-YYYY, or YYYY.']
  end_date text [note: 'Period end in the same formats; null while ongoing. CHECK end_date >= substr(start_date, 1, length(end_date)).']
  tender_reference text [note: 'Procurement reference number (viitenumber). Admins edit; participants read.']
  total_hours integer [note: 'Approximate number: see total_hours_qualifier. Admins edit; participants read.']
  total_hours_qualifier text [note: 'exact, approximately, more_than (CHECK). Null exactly when total_hours is null (CHECK).']
  cost integer [note: 'Whole euros. Approximate number: see cost_qualifier. Admins edit; participants read.']
  cost_qualifier text [note: 'exact, approximately, more_than (CHECK). Null exactly when cost is null (CHECK).']
  import_ref text [note: 'The project number in the imported sheet, such as 10. A re-run of the import updates the project with this ref instead of adding another. Null for projects created in the app.']
  created_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Epoch ms, set by the database.']
  created_by text [not null, ref: > user.id, note: 'Audit. Acting user, set by the app per request.']
  updated_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Last change, shown on the project. Set by the app on update; trigger fallback.']
  updated_by text [not null, ref: > user.id, note: 'Audit. Acting user of the last change, set by the app.']
  sys_deleted integer [not null, default: 0, note: 'Audit. Logical delete, CHECK 0 or 1. Deleted projects leave every list, search, and CV.']

  indexes {
    (organization_id, import_ref) [unique, note: 'Partial: WHERE import_ref IS NOT NULL AND sys_deleted = 0.']
    (organization_id, normalized_name)
    customer_id
    (id, organization_id) [unique, note: 'Target of composite foreign keys.']
  }
}

Table project_contact [note: 'A contact person given as a reference for a project. The app checks that the person belongs to the project customer. Rows are inserted and deleted, never updated.'] {
  project_id text [not null, ref: > project.id, note: 'Composite FK (project_id, organization_id) to project (id, organization_id).']
  contact_person_id text [not null, ref: > contact_person.id, note: 'Composite FK (contact_person_id, organization_id) to contact_person (id, organization_id).']
  organization_id text [not null, ref: > organization.id, note: 'Tenant key, equal to the organization of both sides through the composite foreign keys.']
  created_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Epoch ms, set by the database.']
  created_by text [not null, ref: > user.id, note: 'Audit. Acting user, set by the app per request.']

  indexes {
    (project_id, contact_person_id) [pk]
    organization_id
    contact_person_id
  }
}

Table project_technology [note: 'A technology used on a project. Rows are inserted and deleted, never updated.'] {
  project_id text [not null, ref: > project.id, note: 'Composite FK (project_id, organization_id) to project (id, organization_id).']
  technology_id text [not null, ref: > technology.id, note: 'Composite FK (technology_id, organization_id) to technology (id, organization_id).']
  organization_id text [not null, ref: > organization.id, note: 'Tenant key, equal to the organization of both sides through the composite foreign keys.']
  created_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Epoch ms, set by the database.']
  created_by text [not null, ref: > user.id, note: 'Audit. Acting user, set by the app per request.']

  indexes {
    (project_id, technology_id) [pk]
    organization_id
    technology_id
  }
}

Table project_criterion_answer [note: 'A project answer to a tender criterion. No row means not answered yet.'] {
  project_id text [not null, ref: > project.id, note: 'Composite FK (project_id, organization_id) to project (id, organization_id).']
  criterion_id text [not null, ref: > tender_criterion.id, note: 'Composite FK (criterion_id, organization_id) to tender_criterion (id, organization_id).']
  organization_id text [not null, ref: > organization.id, note: 'Tenant key, equal to the organization of both sides through the composite foreign keys.']
  answer integer [not null, note: 'Boolean, CHECK 0 or 1: yes or no.']
  note text [note: 'Optional detail beyond yes or no, such as REST and SOAP, or Liquibase for translations. One language: an internal checklist note, not CV text.']
  created_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Epoch ms, set by the database.']
  created_by text [not null, ref: > user.id, note: 'Audit. Acting user, set by the app per request.']
  updated_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Set by the app on update; trigger fallback.']
  updated_by text [not null, ref: > user.id, note: 'Audit. Acting user of the last change, set by the app.']

  indexes {
    (project_id, criterion_id) [pk]
    organization_id
    criterion_id
  }
}

// --- People ------------------------------------------------------------------------------

Table employee_profile [note: 'A member CV data in one organization. One per user and organization, created with the membership. A leaver keeps the profile with left_date set; whether and when it is anonymized is an open question (docs/product.md, Leavers).'] {
  id text [pk, note: 'UUIDv7, generated by the app.']
  organization_id text [not null, ref: > organization.id]
  user_id text [not null, ref: > user.id, note: 'Not a foreign key to member: Better Auth deletes member rows on removal, and a leaver profile outlives that.']
  full_name text [not null, note: 'Name as it appears on CVs. Starts as user.name.']
  join_date text [note: 'Date the person joined the organization: YYYY-MM-DD (CHECK on the format).']
  left_date text [note: 'Date the person left the organization: YYYY-MM-DD; null while employed. CHECK left_date >= join_date. Search and CV selection leave out leavers by default; their participations stay on projects. Retention is open (docs/product.md, Leavers).']
  birth_date text [note: 'Optional: YYYY-MM-DD. Shown only to admins and the person; in a CV only when chosen explicitly. No column holds a personal ID code.']
  confirmed_at integer [note: 'Epoch ms of the last time the person confirmed the profile is current. Null until the first confirmation.']
  created_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Epoch ms, set by the database.']
  created_by text [not null, ref: > user.id, note: 'Audit. Acting user, set by the app per request.']
  updated_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Set by the app on update; trigger fallback. The profile last change is the latest updated_at across it, its education, participations, and own projects.']
  updated_by text [not null, ref: > user.id, note: 'Audit. Acting user of the last change, set by the app.']

  indexes {
    (organization_id, user_id) [unique]
    user_id
    (id, organization_id) [unique, note: 'Target of composite foreign keys.']
  }
}

Table education [note: 'An education entry on a profile; a profile has several.'] {
  id text [pk, note: 'UUIDv7, generated by the app.']
  organization_id text [not null, ref: > organization.id]
  profile_id text [not null, ref: > employee_profile.id, note: 'Composite FK (profile_id, organization_id) to employee_profile (id, organization_id).']
  institution_et text [note: 'Bilingual: at least one of institution_et and institution_en (CHECK).']
  institution_en text
  field_et text [note: 'Field of study.']
  field_en text
  degree_et text [note: 'Degree or level, such as MSc.']
  degree_en text
  start_date text [note: 'YYYY-MM-DD, YYYY-MM, or YYYY. Optional: older entries often lack it.']
  end_date text [note: 'YYYY-MM-DD, YYYY-MM, or YYYY; null while ongoing. CHECK end_date >= substr(start_date, 1, length(end_date)).']
  created_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Epoch ms, set by the database.']
  created_by text [not null, ref: > user.id, note: 'Audit. Acting user, set by the app per request.']
  updated_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Set by the app on update; trigger fallback.']
  updated_by text [not null, ref: > user.id, note: 'Audit. Acting user of the last change, set by the app.']
  sys_deleted integer [not null, default: 0, note: 'Audit. Logical delete, CHECK 0 or 1.']

  indexes {
    organization_id
    profile_id
  }
}

Table participation [note: 'A person on an organization project. A person can have several on one project, for different periods or roles.'] {
  id text [pk, note: 'UUIDv7, generated by the app.']
  organization_id text [not null, ref: > organization.id]
  profile_id text [not null, ref: > employee_profile.id, note: 'Composite FK (profile_id, organization_id) to employee_profile (id, organization_id).']
  project_id text [not null, ref: > project.id, note: 'Composite FK (project_id, organization_id) to project (id, organization_id).']
  start_date text [not null, note: 'YYYY-MM-DD, YYYY-MM, or YYYY.']
  end_date text [note: 'YYYY-MM-DD, YYYY-MM, or YYYY; null while ongoing. CHECK end_date >= substr(start_date, 1, length(end_date)).']
  hours integer [note: 'Approximate number: see hours_qualifier.']
  hours_qualifier text [note: 'exact, approximately, more_than (CHECK). Null exactly when hours is null (CHECK).']
  tasks_et text [note: 'What the person did.']
  tasks_en text
  created_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Epoch ms, set by the database.']
  created_by text [not null, ref: > user.id, note: 'Audit. Acting user, set by the app per request.']
  updated_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Set by the app on update; trigger fallback.']
  updated_by text [not null, ref: > user.id, note: 'Audit. Acting user of the last change, set by the app.']
  sys_deleted integer [not null, default: 0, note: 'Audit. Logical delete, CHECK 0 or 1.']

  indexes {
    organization_id
    profile_id
    project_id
    (id, organization_id) [unique, note: 'Target of composite foreign keys.']
  }
}

Table participation_technology [note: 'A technology the person used in a participation: a subset of the project technologies, or an addition to them. Rows are inserted and deleted, never updated.'] {
  participation_id text [not null, ref: > participation.id, note: 'Composite FK (participation_id, organization_id) to participation (id, organization_id).']
  technology_id text [not null, ref: > technology.id, note: 'Composite FK (technology_id, organization_id) to technology (id, organization_id).']
  organization_id text [not null, ref: > organization.id, note: 'Tenant key, equal to the organization of both sides through the composite foreign keys.']
  created_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Epoch ms, set by the database.']
  created_by text [not null, ref: > user.id, note: 'Audit. Acting user, set by the app per request.']

  indexes {
    (participation_id, technology_id) [pk]
    organization_id
    technology_id
  }
}

Table participation_role [note: 'A role the person had in a participation; a participation has one or more. Rows are inserted and deleted, never updated.'] {
  participation_id text [not null, ref: > participation.id, note: 'Composite FK (participation_id, organization_id) to participation (id, organization_id).']
  role_id text [not null, ref: > project_role.id, note: 'Composite FK (role_id, organization_id) to project_role (id, organization_id).']
  organization_id text [not null, ref: > organization.id, note: 'Tenant key, equal to the organization of both sides through the composite foreign keys.']
  created_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Epoch ms, set by the database.']
  created_by text [not null, ref: > user.id, note: 'Audit. Acting user, set by the app per request.']

  indexes {
    (participation_id, role_id) [pk]
    organization_id
    role_id
  }
}

Table own_project [note: 'A project that appears only on its owner CV: from an earlier employer, or several engagements merged into one. A separate table, so no project list or search over project can include it. Holds the project and the owner participation in one row.'] {
  id text [pk, note: 'UUIDv7, generated by the app.']
  organization_id text [not null, ref: > organization.id]
  profile_id text [not null, ref: > employee_profile.id, note: 'The owner. Composite FK (profile_id, organization_id) to employee_profile (id, organization_id).']
  name text [not null]
  employer text [note: 'The company the work was done for, when it was not this organization.']
  customer_name text [note: 'Free text: the customer is outside the organization customer list. No contact persons are stored for own projects.']
  description_et text
  description_en text
  start_date text [not null, note: 'YYYY-MM-DD, YYYY-MM, or YYYY.']
  end_date text [note: 'YYYY-MM-DD, YYYY-MM, or YYYY; null while ongoing. CHECK end_date >= substr(start_date, 1, length(end_date)).']
  tender_reference text
  total_hours integer [note: 'Project total. Approximate number: see total_hours_qualifier.']
  total_hours_qualifier text [note: 'exact, approximately, more_than (CHECK). Null exactly when total_hours is null (CHECK).']
  cost integer [note: 'Whole euros. Approximate number: see cost_qualifier.']
  cost_qualifier text [note: 'exact, approximately, more_than (CHECK). Null exactly when cost is null (CHECK).']
  hours integer [note: 'Owner hours. Approximate number: see hours_qualifier.']
  hours_qualifier text [note: 'exact, approximately, more_than (CHECK). Null exactly when hours is null (CHECK).']
  tasks_et text
  tasks_en text
  created_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Epoch ms, set by the database.']
  created_by text [not null, ref: > user.id, note: 'Audit. Acting user, set by the app per request.']
  updated_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Set by the app on update; trigger fallback.']
  updated_by text [not null, ref: > user.id, note: 'Audit. Acting user of the last change, set by the app.']
  sys_deleted integer [not null, default: 0, note: 'Audit. Logical delete, CHECK 0 or 1.']

  indexes {
    organization_id
    profile_id
    (id, organization_id) [unique, note: 'Target of composite foreign keys.']
  }
}

Table own_project_technology [note: 'A catalogue technology used on an own project. Rows are inserted and deleted, never updated.'] {
  own_project_id text [not null, ref: > own_project.id, note: 'Composite FK (own_project_id, organization_id) to own_project (id, organization_id).']
  technology_id text [not null, ref: > technology.id, note: 'Composite FK (technology_id, organization_id) to technology (id, organization_id).']
  organization_id text [not null, ref: > organization.id, note: 'Tenant key, equal to the organization of both sides through the composite foreign keys.']
  created_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Epoch ms, set by the database.']
  created_by text [not null, ref: > user.id, note: 'Audit. Acting user, set by the app per request.']

  indexes {
    (own_project_id, technology_id) [pk]
    organization_id
    technology_id
  }
}

Table own_project_role [note: 'The owner role on an own project; an own project has one or more. Rows are inserted and deleted, never updated.'] {
  own_project_id text [not null, ref: > own_project.id, note: 'Composite FK (own_project_id, organization_id) to own_project (id, organization_id).']
  role_id text [not null, ref: > project_role.id, note: 'Composite FK (role_id, organization_id) to project_role (id, organization_id).']
  organization_id text [not null, ref: > organization.id, note: 'Tenant key, equal to the organization of both sides through the composite foreign keys.']
  created_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Epoch ms, set by the database.']
  created_by text [not null, ref: > user.id, note: 'Audit. Acting user, set by the app per request.']

  indexes {
    (own_project_id, role_id) [pk]
    organization_id
    role_id
  }
}

Table update_request [note: 'An admin asks a person to bring their profile up to date. The person sees open requests on sign-in; confirming the profile closes them.'] {
  id text [pk, note: 'UUIDv7, generated by the app.']
  organization_id text [not null, ref: > organization.id]
  profile_id text [not null, ref: > employee_profile.id, note: 'Composite FK (profile_id, organization_id) to employee_profile (id, organization_id).']
  message text [note: 'Optional note from the admin, such as add the 2026 projects.']
  closed_at integer [note: 'Epoch ms. Set when the person confirms the profile or an admin cancels the request; null while open.']
  closed_reason text [note: 'confirmed or canceled (CHECK). Null exactly when closed_at is null (CHECK).']
  created_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. When the request was made. Epoch ms, set by the database.']
  created_by text [not null, ref: > user.id, note: 'Audit. The requesting admin, set by the app per request.']
  updated_at integer [not null, default: `CAST(ROUND(unixepoch('subsec') * 1000) AS INTEGER)`, note: 'Audit. Set by the app on update; trigger fallback.']
  updated_by text [not null, ref: > user.id, note: 'Audit. Acting user of the last change: who closed it.']

  indexes {
    organization_id
    profile_id [unique, note: 'Partial: WHERE closed_at IS NULL. At most one open request per profile.']
  }
}

