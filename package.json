{
  "name": "snowprofile",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "env:init": "bun scripts/env-init.ts",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --silent",
    "db:generate": "bun scripts/db-generate.ts",
    "db:migrate": "bun scripts/db-migrate.ts",
    "db:verify": "bun scripts/db-verify.ts",
    "db:drift": "bun scripts/db-drift.ts",
    "db:seed": "bun scripts/db-seed.ts",
    "prototypes:build": "bun scripts/prototypes-build.ts",
    "datamodel": "bun run datamodel:build && docker compose -f datamodel/docker-compose.yml up -d && echo 'ChartDB: http://localhost:8080 (Import > .json > datamodel/snowprofile.chartdb.json)'",
    "datamodel:build": "bun datamodel/dbml-to-chartdb.mjs",
    "datamodel:stop": "docker compose -f datamodel/docker-compose.yml down",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "check": "bun run i18n:compile && bun run format:check && bun run lint && bun run typecheck",
    "test": "bun run i18n:compile && bun test --randomize && vitest run",
    "test:server": "bun test --randomize",
    "test:components": "vitest run",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@libsql/client": "0.18.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-query-devtools": "5.104.0",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.60",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "lucide-react": "1.49.0",
    "nitro": "3.0.260903-beta",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "uuid": "14.0.2",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.25.4",
    "@inlang/plugin-message-format": "4.4.0",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/devtools-vite": "0.8.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.4.2",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "1.0.0-rc.4",
    "jsdom": "30.1.1",
    "lefthook": "2.1.16",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "packageManager": "bun@1.4.2"
}
